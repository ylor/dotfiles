# https://ghostty.org/docs/config

# function
clipboard-read = "allow"
clipboard-paste-protection = false
copy-on-select = true
focus-follows-mouse = true
confirm-close-surface = false
window-save-state = always

# form
theme = mfd-nerv
alpha-blending = linear-corrected
background = #000000
#background-blur = macos-glass-regular
background-blur = true
background-opacity = 0.90
palette-generate=true
# font-family = "SF Mono"
# font-family = "Jetbrains Mono"
# font-family = "Berkeley Mono Retina"
font-family = "Berkeley Mono Variable"
font-style = "SemiCondensed"
font-style-bold = "Bold SemiCondensed"
font-style-italic = "SemiCondensed Oblique"
font-style-bold-italic = "Bold SemiCondensed Oblique"
# font-size = 16
macos-titlebar-style = tabs
window-padding-balance = true
# window-padding-x = 2
window-padding-y = 0
# window-subtitle = working-directory
unfocused-split-opacity = 0.9

# shaders
# custom-shader = shaders/tft.glsl
custom-shader = shaders/bloom.glsl

# keybinds
keybind = ctrl+-=new_split:down
keybind = ctrl+==new_split:right
keybind = ctrl+\=new_split:right

# modules
config-file = ?mac
config-file = ?linux
config-file = ?local

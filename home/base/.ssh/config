Include ~/.local/ssh/config

Host *
  SendEnv COLORTERM
  SetEnv TERM=xterm-256color
  ServerAliveInterval 60

  Match exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
    IdentityAgent "${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

  Match exec "test -S '%d/.1password/agent.sock'"
    IdentityAgent "${HOME}/.1password/agent.sock"

Host o oma omarchy z zelda
    User roly
    HostName 10.0.1.4
    ForwardAgent yes
    RequestTTY yes
    RemoteCommand exec fish --login


Host z zelda
    User roly
    HostName 10.0.1.2
    ForwardAgent yes

Match host roly.sh,roly.ssh exec "command -v cloudflared"
    User roly
    ProxyCommand cloudflared access ssh --hostname ssh.roly.sh

Match host github.com exec "pwd | grep -i papa"
    HostName github.com
    User git
    IdentityFile ~/.ssh/papa.pub
    IdentitiesOnly yes

# https://ghostty.org/docs/config

config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
config-file = ?local

# function
command = fish
font-size = 10
clipboard-read = "allow"
clipboard-paste-protection = false
copy-on-select = true
focus-follows-mouse = true
confirm-close-surface = false
window-save-state = always

# form
window-theme = ghostty
alpha-blending = linear-corrected
# TUIs paint explicit backgrounds that would otherwise stay opaque
background-opacity-cells = true
font-family = "Berkeley Mono Variable"
palette-generate=true
window-padding-balance = true
window-padding-y = 0
unfocused-split-opacity = 0.9

# shaders
custom-shader = shaders/bloom.glsl
resize-overlay = never
gtk-toolbar-style = flat
gtk-custom-css = ?~/.local/state/omarchy/current/theme/ghostty.css

# keybinds
keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard
keybind = performable:ctrl+k=clear_screen
keybind = performable:ctrl+t=new_tab
keybind = ctrl+w=close_surface
keybind = ctrl+-=new_split:down
keybind = ctrl+==new_split:right
keybind = ctrl+\=new_split:right

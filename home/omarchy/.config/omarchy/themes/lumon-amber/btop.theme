# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#100600"

# Main text color
theme[main_fg]="#ff6b08"

# Title color for boxes
theme[title]="#ff6b08"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff6b08"

# Background color of selected item in processes box
theme[selected_bg]="#5b2500"

# Foreground color of selected item in processes box
theme[selected_fg]="#ff6b08"

# Color of inactive/disabled text
theme[inactive_fg]="#5b2500"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#ffa86d"

# Background color of the percentage meters
theme[meter_bg]="#5b2500"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ffa86d"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#ab4500"
theme[mem_box]="#ff6b08"
theme[net_box]="#ff0043"
theme[proc_box]="#ff6b08"

# Box divider line and small boxes line color
theme[div_line]="#5b2500"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#ff6b08"
theme[temp_mid]="#ffa86d"
theme[temp_end]="#ff0043"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#ab4500"
theme[cpu_mid]="#ab4500"
theme[cpu_end]="#ab4500"

# Mem/Disk free meter
theme[free_start]="#ab4500"
theme[free_mid]="#ab4500"
theme[free_end]="#ab4500"

# Mem/Disk cached meter
theme[cached_start]="#ab4500"
theme[cached_mid]="#ab4500"
theme[cached_end]="#ab4500"

# Mem/Disk available meter
theme[available_start]="#ffa86d"
theme[available_mid]="#ff0043"
theme[available_end]="#ff0043"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#ff6b08"
theme[used_mid]="#ab4500"
theme[used_end]="#ab4500"

# Download graph colors
theme[download_start]="#ffa86d"
theme[download_mid]="#ff0043"
theme[download_end]="#ff0043"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#ff6b08"
theme[upload_mid]="#ab4500"
theme[upload_end]="#ab4500"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#ab4500"
theme[process_mid]="#ab4500"
theme[process_end]="#ab4500"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#100600"
theme[gradient_color_1]="#1b0c02"
theme[gradient_color_2]="#5b2500"
theme[gradient_color_3]="#5b2500"
theme[gradient_color_4]="#dd5800"
theme[gradient_color_5]="#ff6b08"
theme[gradient_color_6]="#ffa86d"
theme[gradient_color_7]="#ffa86d"

#!/bin/sh
# World of Warcraft helper (Forever only for now): launch the game, manage addons, list characters.
set -eu

cmd=play
check=0
forever=

usage() {
    printf '%s\n' \
        'Usage: wow [play]                                 Launch through Battle.net' \
        '       wow addons [--check] [--forever-dir PATH]  Install or update addons' \
        '       wow toons [--forever-dir PATH]             List characters, copy to clipboard' \
        'After addons, run /reload in game to load updates. Addon settings are preserved.'
}

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

case "${1:-}" in
    play|addons|toons) cmd=$1; shift ;;
esac
while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            [ "$cmd" = addons ] || fail '--check only applies to wow addons'
            check=1
            ;;
        --forever-dir)
            [ "$cmd" != play ] || fail '--forever-dir does not apply to wow play'
            [ "$#" -ge 2 ] || fail '--forever-dir needs a path'
            forever=$2
            shift
            ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

# Sets $forever to the game's _forever_ folder unless --forever-dir gave it.
find_forever() {
    [ -z "$forever" ] || return 0
    found=
    for game in "$HOME"/Games/*/drive_c/Program\ Files*/World\ of\ Warcraft/_forever_ \
                "$HOME"/.wine/drive_c/Program\ Files*/World\ of\ Warcraft/_forever_; do
        [ -d "$game" ] || continue
        found="$found$game
"
        forever=$game
    done
    [ -n "$forever" ] || fail 'No Forever install found; use --forever-dir'
    if [ "$(printf '%s' "$found" | wc -l)" -gt 1 ]; then
        printf '%s' "$found" >&2
        fail 'Multiple Forever installs found; use --forever-dir with one of the above'
    fi
}

play() {
    prefix=$HOME/Games/battlenet
    launcher=$prefix/drive_c/Program\ Files\ \(x86\)/Battle.net/Battle.net.exe
    logs=$prefix/drive_c/users/steamuser/AppData/Local/Battle.net/Logs
    # proton-hdr: the game inherits Battle.net's environment, so HDR is set on Battle.net.
    set -- env WINEPREFIX="$prefix" NVPRESENT_ENABLE_SMOOTH_MOTION=1 PROTONPATH=GE-Proton \
        GAMEID=umu-battlenet PROTON_VERB=run proton-hdr umu-run "$launcher"

    # A cold-started Battle.net ignores --exec, so start it, wait for its login,
    # then hand the launch to the running instance (the game needs it for -launcherlogin).
    if ! pgrep -f 'Battle\.net\.exe' >/dev/null; then
        newest_log() { ls -t "$logs"/battle.net-*.log 2>/dev/null | head -n 1; }
        before=$(newest_log)
        "$@" >/dev/null 2>&1 &
        for _ in $(seq 120); do
            sleep 1
            log=$(newest_log)
            [ "$log" != "$before" ] && grep -aq 'Logged into Battle.net successfully' "$log" && break
        done
    fi

    exec "$@" --exec='launch WoWF'
}

# Prints character names (sorted, "-" replaced by a space) and copies them to the clipboard.
# Names come from the WTF folders, which WoW never cleans up, so deleted characters still show.
toons() {
    find_forever
    # Layout: WTF/Account/<account>/<realm>/<character>
    names=$(find "$forever/WTF/Account" -mindepth 3 -maxdepth 3 -type d ! -name SavedVariables \
        -printf '%f\n' | tr '-' ' ' | sort -fu)
    printf '%s\n' "$names"
    printf '%s' "$names" | wl-copy
}

# Everything below is `wow addons`; addons() and its addon list are at the bottom.

game_version=1.60.1
interface=16001

# Removes downloads and shows the cursor again, which the live status rows hide.
cleanup() {
    rm -rf "$tmp"
    [ "$tty" -eq 0 ] || printf '\033[?25h'
}

# Usage: say COLOR TEXT. COLOR is an ANSI code: 31 red, 32 green, 33 yellow, 90 gray.
say() {
    if [ "$tty" -eq 1 ]; then
        printf '\033[%sm%s\033[0m\n' "$1" "$2"
    else
        printf '%s\n' "$2"
    fi
}

# Usage: status STATE TEXT. Jobs write their state here and the main loop draws it.
# STATE is busy, ok, new, updated, available or failed.
status() {
    # Write then rename, so the main loop never reads a half-written file.
    printf '%s %s\n' "$1" "$2" > "$status_file.new"
    mv "$status_file.new" "$status_file"
}

fetch() {
    curl --fail --silent --show-error --location --retry 2 \
        --connect-timeout 15 --speed-limit 1024 --speed-time 60 "$1" -o "$2"
}

# Usage: toc_field FILE KEY. Prints the value of the "## KEY:" line, ignoring a UTF-8
# BOM (Pawn's TOC starts with one) and CRLF line endings.
toc_field() {
    awk -v key="## $2:" -v bom='\357\273\277' '
        NR == 1 && index($0, bom) == 1 { $0 = substr($0, length(bom) + 1) }
        { sub(/\r$/, "") }
        index($0, key) == 1 { $0 = substr($0, length(key) + 1); sub(/^[[:space:]]+/, ""); print; exit }
    ' "$1"
}

declares_interface() {
    toc_field "$1" Interface | grep -Eq "(^|[^0-9])$interface([^0-9]|\$)"
}

# Prints "FILE_ID URL" for the newest file for $game_version whose name matches a regex.
curseforge_zip() {
    fetch "https://api.cfwidget.com/$1" "$tmp/release.json"
    jq -er --arg re "$2" --arg ver "$game_version" '
        [.files[] | select(.versions | any(startswith($ver))) | select(.name | test($re))] |
        max_by(.id) |
        if . == null then error("No file matches \($re) for \($ver)") else . end |
        "\(.id) https://mediafilez.forgecdn.net/files/\((.id / 1000) | floor)/\(.id % 1000)/\(.name)"
    ' "$tmp/release.json"
}

# Usage: install_addon ADDON TOC_FILE CURSEFORGE_PROJECT_ID FILE_NAME_REGEX
# Installs every top-level folder in the zip, so multi-folder addons like Spoken work.
install_addon() {
    addon=$1
    toc=$addon/$2
    release=$(curseforge_zip "$3" "$4")
    file_id=${release%% *}
    url=${release#* }

    # Release URLs change with every version, so a known URL means nothing to download.
    url_file=$addons_dir/$addon/.wow-addons-url
    cached_url=
    [ ! -f "$url_file" ] || read -r cached_url < "$url_file" || :
    installed='new'
    [ ! -f "$addons_dir/$toc" ] || installed=$(toc_field "$addons_dir/$toc" Version)
    # Some addons, like HDRTuner, have no version in their TOC.
    [ -n "$installed" ] || installed='unversioned'
    if [ "$cached_url" = "$url" ] && [ "$installed" != new ]; then
        status ok "$installed"
        return 0
    fi
    # --check reports the new file name instead of downloading it (voice packs are huge).
    if [ "$check" -eq 1 ]; then
        status available "$installed -> ${url##*/}"
        return 0
    fi

    status busy "downloading ${url##*/}"
    fetch "$url" "$tmp/addon.zip"
    unzip -Z1 "$tmp/addon.zip" | awk -v addon="$addon" '
        /^\// || /\\/ || /(^|\/)\.\.(\/|$)/ { exit 1 }
        { split($0, parts, "/"); if (index(parts[1], addon) != 1) exit 1 }
    ' || fail "$addon: unsafe archive paths"

    unzip -l "$tmp/addon.zip" "$toc" >/dev/null 2>&1 || fail "$addon: $toc not in archive"
    unzip -p "$tmp/addon.zip" "$toc" > "$tmp/addon.toc"
    declares_interface "$tmp/addon.toc" ||
        fail "$addon: release does not declare Interface $interface support"
    latest=$(toc_field "$tmp/addon.toc" Version)
    # Without one, name the release by its CurseForge file ID.
    [ -n "$latest" ] || latest="file $file_id"

    if [ "$installed" != "$latest" ]; then
        status busy "installing $latest"
        # Extract completely before removing obsolete files from the old installation.
        mkdir -p "$tmp/staging"
        unzip -q "$tmp/addon.zip" -d "$tmp/staging"
        # unzip keeps the archive's file modes; Battle.net refuses to update the game
        # when an addon file is unreadable or read-only (agent error 2113).
        chmod -R u+rwX,go+rX "$tmp/staging"
        for dir in "$tmp/staging"/*/; do
            name=${dir%/}
            name=${name##*/}
            target=$addons_dir/$name
            [ ! -L "$target" ] || fail "Refusing to replace symlink: $target"
            rm -rf "$target"
            # Skip debug builds (folders ending in _Debug).
            case "$name" in
                *_Debug) continue ;;
            esac
            mv "$dir" "$target"
        done
    fi
    printf '%s\n' "$url" > "$url_file"
    if [ "$installed" = "$latest" ]; then
        status ok "$latest"
    elif [ "$installed" = new ]; then
        status new "$latest"
    else
        status updated "$installed -> $latest"
    fi
}

# Usage: start NAME COMMAND... Runs the command in the background with its own temp
# dir, log and status file, so downloads overlap.
pending=
spinner='-'
start() {
    name=$1
    shift
    mkdir "$tmp/$name"
    printf 'busy checking\n' > "$tmp/$name.status"
    (status_file=$tmp/$name.status; tmp=$tmp/$name; "$@") > "$tmp/$name.log" 2>&1 &
    pending="$pending $!:$name"
}

update() {
    start "$1" install_addon "$@"
}

running() {
    for job in $pending; do
        ! kill -0 "${job%%:*}" 2>/dev/null || return 0
    done
    return 1
}

# Prints one status row per addon. In a terminal every row shows, so the rows can be
# redrawn in place; otherwise only rows worth reading are printed.
draw() {
    for job in $pending; do
        name=${job#*:}
        read -r state text < "$tmp/$name.status"
        mark_color=
        case "$state" in
            busy) mark=$spinner; color=90 ;;
            # Green check, gray text: done, but nothing changed.
            ok) mark='✓'; color=90; mark_color=32; text="$text up to date" ;;
            new) mark='✓'; color=32; text="$text installed" ;;
            updated) mark='✓'; color=32 ;;
            available) mark='↑'; color=33 ;;
            failed) mark='✗'; color=31 ;;
        esac
        if [ "$tty" -eq 1 ]; then
            # Cut long text so a row never wraps, which would break the redraw.
            printf '\033[K\033[%sm%s\033[0m %-26s \033[%sm%.*s\033[0m\n' \
                "${mark_color:-$color}" "$mark" "$name" "$color" "$width" "$text"
        elif [ "$state" != ok ]; then
            printf '%s %s: %s\n' "$mark" "$name" "$text"
        fi
    done
}

# Shows live rows until every job ends, then the final rows and totals.
wait_all() {
    set -- $pending
    rows=$#
    width=$(( $(tput cols 2>/dev/null || echo 80) - 30 ))
    if [ "$tty" -eq 1 ]; then
        printf '\033[?25l'
        frame=0
        while running; do
            case $((frame % 4)) in 0) spinner='⠋' ;; 1) spinner='⠙' ;; 2) spinner='⠸' ;; 3) spinner='⠴' ;; esac
            draw
            sleep 0.1
            printf '\033[%sA' "$rows"
            frame=$((frame + 1))
        done
    fi

    failed=0
    changed=0
    for job in $pending; do
        name=${job#*:}
        if ! wait "${job%%:*}"; then
            failed=$((failed + 1))
            reason=$(grep . "$tmp/$name.log" | tail -n 1 | sed 's/^Error: //')
            status_file=$tmp/$name.status status failed "${reason:-unknown error}"
        else
            read -r state _ < "$tmp/$name.status"
            [ "$state" = ok ] || changed=$((changed + 1))
        fi
    done
    width=1000
    draw
}

# Our own addons, kept in the dotfiles and copied in on every run.
own_dir=${XDG_DATA_HOME:-$HOME/.local/share}/wow-addons

# Usage: install_own_addon NAME
install_own_addon() {
    src=$own_dir/$1
    dir=$addons_dir/$1
    declares_interface "$src/$1.toc" ||
        fail "$1: $src/$1.toc does not declare Interface $interface"
    if diff -rq "$src" "$dir" >/dev/null 2>&1; then
        status ok "$(toc_field "$src/$1.toc" Version)"
    elif [ "$check" -eq 1 ]; then
        status available 'changed'
    else
        # The sources are symlinks into the dotfiles, so copy what they point to.
        cp -RL "$src" "$tmp/$1"
        rm -rf "$dir"
        mv "$tmp/$1" "$dir"
        status updated 'copied'
    fi
}

addons() {
    for tool in curl jq unzip; do
        command -v "$tool" >/dev/null 2>&1 || fail "Required command not found: $tool"
    done

    find_forever
    addons_dir=$forever/Interface/AddOns
    # Keep downloads next to AddOns so installing is a rename, not a multi-GB copy.
    mkdir -p "$addons_dir"
    tmp=$(mktemp -d "$addons_dir/../.wow.XXXXXX")
    tty=0
    [ ! -t 1 ] || tty=1
    trap cleanup 0
    # Exit on signals so the cleanup trap runs.
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP

    # Only plain numbered releases; Baganator-841-3-ge3f466e.zip style names are alphas.
    update Auctionator Auctionator.toc 6124 '^Auctionator-[0-9]+\.zip$'
    update Baganator Baganator.toc 914482 '^Baganator-[0-9]+\.zip$'
    update BetterBlizzFrames BetterBlizzFrames_Camelot.toc 940950 '^BetterBlizzFrames-v[0-9.]+[a-z]?\.zip$'
    update BetterBlizzPlates BetterBlizzPlates_Camelot.toc 913377 '^BetterBlizzPlates-v[0-9.]+[a-z]?\.zip$'
    update DialogueUI DialogueUI.toc 989270 '^DialogueUI-[A-Za-z0-9.-]+\.zip$'
    update DoesItDie DoesItDie.toc 1709161 '^DoesItDie-v[0-9.]+-forever\.zip$'
    # The author's file names vary (_v1.3.0, 1.6.3, -1.6.7), so match loosely.
    update ForeverDungeonJournal ForeverDungeonJournal.toc 1707971 '^ForeverDungeonJournal.*\.zip$'
    update ForeverLootSparkles ForeverLootSparkles.toc 1729017 '^ForeverLootSparkles-v[0-9.]+-forever\.zip$'
    update ForeverQuestTint ForeverQuestTint.toc 1703732 '^ForeverQuestTint-[A-Za-z0-9.-]+\.zip$'
    update HDRTuner HDRTuner.toc 1701739 '^HDRTuner\.zip$'
    update KeepOrToss KeepOrToss.toc 1737994 '^KeepOrToss-[0-9.]+\.zip$'
    update Leatrix_Plus Leatrix_Plus.toc 94855 '^Leatrix_Plus-[A-Za-z0-9.-]+-forever\.zip$'
    update NodeSight NodeSight.toc 1731463 '^NodeSight-[0-9.]+\.zip$'
    update OpenMap OpenMap.toc 1735937 '^OpenMap-[A-Za-z0-9.-]+\.zip$'
    update Pawn Pawn.toc 4646 '^Pawn-[0-9.]+-Forever\.zip$'
    update PrettyTooltip PrettyTooltip.toc 1720719 '^PrettyTooltip-v[0-9.]+-forever\.zip$'
    update Questie Questie_Forever.toc 334372 '^Questie-v[0-9.]+\.zip$'
    # KeepOrToss reads quest data from this, not from Questie. Older names lack the version.
    update QuestieDB QuestieDB_Forever.toc 1696795 '^QuestieDB-([0-9.]+-)?Forever\.zip$'
    update Spoken Spoken.toc 1700375 '^Spoken-[0-9.]+\.zip$'
    # English voice packs for Spoken; it is silent without them. Each is 300-500 MB.
    update SpokenBossesAudio SpokenBossesAudio.toc 1780747 '^SpokenBossesAudio-[0-9.]+\.zip$'
    update SpokenPlacesAudio SpokenPlacesAudio.toc 1636532 '^SpokenPlacesAudio-[0-9.]+\.zip$'
    update SpokenQuestsAudioAlliance SpokenQuestsAudioAlliance.toc 1660197 '^SpokenQuestsAudioAlliance-[0-9.]+\.zip$'
    update SpokenQuestsAudioGossip SpokenQuestsAudioGossip.toc 1660202 '^SpokenQuestsAudioGossip-[0-9.]+\.zip$'
    update SpokenQuestsAudioHorde SpokenQuestsAudioHorde.toc 1660198 '^SpokenQuestsAudioHorde-[0-9.]+\.zip$'
    update SpokenQuestsAudioShared SpokenQuestsAudioShared.toc 1660199 '^SpokenQuestsAudioShared-[0-9.]+\.zip$'
    update SpokenReadablesAudio SpokenReadablesAudio.toc 1701520 '^SpokenReadablesAudio-[0-9.]+\.zip$'
    # Baganator does nothing without Syndicator. Same alpha naming as Baganator.
    update Syndicator Syndicator.toc 988370 '^Syndicator-[0-9]+\.zip$'
    update WhatsTraining WhatsTraining.toc 324944 '^WhatsTraining-[0-9.]+\.zip$'
    start Lush install_own_addon Lush
    start OptimizedGraphics install_own_addon OptimizedGraphics
    wait_all

    if [ "$failed" -gt 0 ]; then
        say 31 "$failed addon(s) failed"
        exit 1
    elif [ "$changed" -eq 0 ]; then
        say 32 'All addons up to date'
    elif [ "$check" -eq 1 ]; then
        say 33 "$changed update(s) available; run wow addons to install"
    else
        say 32 "Updated $changed addon(s)"
        if pgrep -fi '_forever_.*\.exe' >/dev/null; then
            say 33 'WoW Forever is running; /reload in game to load updated addons'
        fi
    fi
}

"$cmd"

#!/bin/sh
# Print WoW Forever character names (sorted, "-" replaced by a space) and copy them to the clipboard.
# Names come from the WTF folders, which WoW never cleans up, so deleted characters still show.
set -eu

for wtf in "$HOME"/Games/*/drive_c/Program\ Files*/World\ of\ Warcraft/_forever_/WTF/Account; do
    [ -d "$wtf" ] && break
done
[ -d "$wtf" ] || { echo 'Error: no WoW Forever install found' >&2; exit 1; }

# Layout: Account/<account>/<realm>/<character>
names=$(find "$wtf" -mindepth 3 -maxdepth 3 -type d ! -name SavedVariables -printf '%f\n' |
    tr '-' ' ' | sort -fu)

printf '%s\n' "$names"
printf '%s' "$names" | wl-copy

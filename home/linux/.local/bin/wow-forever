#!/bin/bash
set -e

prefix="$HOME/Games/battlenet"
launcher="$prefix/drive_c/Program Files (x86)/Battle.net/Battle.net.exe"

# go through Battle.net so the game gets the saved login
exec env WINEPREFIX="$prefix" PROTONPATH=GE-Proton GAMEID=umu-battlenet PROTON_VERB=run umu-run "$launcher" --exec="launch_uid wow_classic_beta"

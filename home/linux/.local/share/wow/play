# wow play: update addons, then launch the game through Battle.net.
set -eu

here=$(dirname "$0")
# shellcheck source=lib.sh
. "$here/lib.sh"
parse_args "$@"
# Taken now, before the addon update, so switching away during it doesn't change it.
workspace=$(hyprctl activeworkspace -j 2>/dev/null | jq -r .id)

find_forever
# Update addons first. A failure doesn't block the launch.
sh "$here/addons" --forever-dir "$forever" || printf 'Addon update failed; launching anyway\n' >&2
prefix=${forever%%/drive_c/*}
launcher=$prefix/drive_c/Program\ Files\ \(x86\)/Battle.net/Battle.net.exe
logs=$prefix/drive_c/users/steamuser/AppData/Local/Battle.net/Logs
# proton-hdr: the game inherits Battle.net's environment, so HDR is set on Battle.net.
# Pinned: PROTONPATH=GE-Proton makes umu fetch the newest release, and
# GE-Proton11-13 kills Battle.net as it opens its window (11-12 works).
proton=$HOME/.local/share/Steam/compatibilitytools.d/GE-Proton11-12-x86_64
set -- env WINEPREFIX="$prefix" NVPRESENT_ENABLE_SMOOTH_MOTION=1 PROTONPATH="$proton" \
    GAMEID=umu-battlenet PROTON_VERB=run proton-hdr umu-run "$launcher"

# Send new Battle.net and WoW windows to the workspace this was started from, with
# a window rule so they open there instead of wherever you are by then. WoW asks to go
# fullscreen on a monitor, which would move it to that monitor's current workspace, so
# that (and its focus requests) are ignored while the rule is on. The rule is
# turned off once WoW's window opens (or after 10 minutes), so later launches aren't caught.
if [ -n "$workspace" ]; then
    rule() { hyprctl eval "hl.window_rule({ name = 'wow-play-workspace', $1 })"; }
    rule "match = { class = '^(battle[.]net|wowb?)[.]exe\$' }, workspace = '$workspace silent', suppress_event = 'fullscreenoutput activate activatefocus', enabled = true" >/dev/null
    (
        timeout 600 socat -U - "UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" |
            grep -qEm1 '^openwindow>>[^,]*,[^,]*,wowb?[.]exe,' || true
        rule 'enabled = false'
    ) >/dev/null 2>&1 &
fi

# A cold-started Battle.net ignores --exec, so start it, wait for its login,
# then hand the launch to the running instance (the game needs it for -launcherlogin).
if ! pgrep -f 'Battle\.net\.exe' >/dev/null; then
    # Log names are plain timestamps, so ls is safe here.
    # shellcheck disable=SC2012
    newest_log() { ls -t "$logs"/battle.net-*.log 2>/dev/null | head -n 1; }
    before=$(newest_log)
    "$@" >/dev/null 2>&1 &
    for _ in $(seq 120); do
        sleep 1
        log=$(newest_log)
        # Login alone isn't enough: until WoW's versioning finishes, Battle.net drops --exec.
        # Versioning is logged after login, so it alone means both are done.
        [ "$log" != "$before" ] || continue
        grep -aq 'Game finished versioning wowf' "$log" && break
    done
fi

# Battle.net can still drop the launch (a slow login, or log lines worded differently), so
# check that a new Wow.exe appears, and ask once more if not. A game that was already
# running isn't taken for this launch: only a newest Wow.exe that wasn't newest before counts.
newest_game() { pgrep -nf '_forever_.Wow\.exe' || true; }
old_game=$(newest_game)
for attempt in 1 2; do
    "$@" --exec='launch WoWF' >/dev/null 2>&1 &
    for _ in $(seq 60); do
        sleep 1
        game=$(newest_game)
        [ -z "$game" ] || [ "$game" = "$old_game" ] || exit 0
    done
    [ "$attempt" -eq 2 ] || printf 'WoW has not started after 60s; asking Battle.net again\n' >&2
done
fail 'WoW did not start; launch it from Battle.net'

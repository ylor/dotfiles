# https://ghostty.org/docs/config

# function
clipboard-read = "allow"
clipboard-paste-protection = false
copy-on-select = true
focus-follows-mouse = true
window-save-state = always

# form
theme = mfd-nerv
background = #000000
#background-blur = macos-glass-regular
background-blur = true
background-opacity = 0.85
palette-generate=true
#font-family = "SF Mono"
font-family = "Berkeley Mono Retina"
# font-size = 16
macos-titlebar-style = tabs
window-padding-balance = true
window-padding-x = 8
# window-subtitle = working-directory
unfocused-split-opacity = 0.9

# shaders
# custom-shader = shaders/vt320-amber.glsl
# custom-shader = shaders/crt.glsl
custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders/tft.glsl
custom-shader = shaders/bloom.glsl
# custom-shader = shaders/amber.glsl
# custom-shader = shaders/retro-terminal2.glsl
# custom-shader-animation = false

# keybinds
keybind = ctrl+-=new_split:down
keybind = ctrl+==new_split:right
keybind = ctrl+\=new_split:right

# modules
config-file = ?mac
config-file = ?linux
config-file = ?local
